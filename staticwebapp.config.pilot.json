{
    "routes": [
        {
            "route": "/api/ping",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/refresh-fs",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/power-bi",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/otp/*",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/skjematyper/*/publikum",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/skjemaer",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/skjemaer/*",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/ny-skjema-id/*",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/vedlegg/*",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/utsending",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/utsending/valider",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/utsending/for-meg",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/oppslag",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/utsending/purre",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/logo/*",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/systemlogo",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/postnumre/refresh-bring",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/backup/kjor",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/cache/teammedlemskap",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/nokkelkalender/sjekk",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/utsending/send-forfalte",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/admin.html",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/migrer.html",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/editor.html",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/login",
            "redirect": "/.auth/login/aad?post_login_redirect_uri=/"
        },
        {
            "route": "/logout",
            "redirect": "/.auth/logout"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*", "/*.{png,jpg,jpeg,gif,svg,ico,css,js,woff,woff2}"]
    },
    "auth": {
        "identityProviders": {
            "azureActiveDirectory": {
                "registration": {
                    "openIdIssuer": "https://login.microsoftonline.com/v2.0/e4fcc393-7190-4d3d-a38d-fa6429f870f3",
                    "clientIdSettingName": "ad0eed27-4fd3-48cf-9b78-80637eb8d2f2",
                    "clientSecretSettingName": "AAD_CLIENT_SECRET"
                }
            }
        }
    },
    "responseOverrides": {
        "401": {
            "statusCode": 302,
            "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer"
        }
    },
    "globalHeaders": {
        "Cache-Control": "no-store, must-revalidate",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
    }
}
