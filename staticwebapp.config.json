{
    "routes": [
        {
            "route": "/api/ping",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/refresh-fs",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/admin.html",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/migrer.html",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/nokkeladmin.html",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/rolleadmin.html",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/editor.html",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/login",
            "redirect": "/.auth/login/aad?post_login_redirect_uri=/"
        },
        {
            "route": "/logout",
            "redirect": "/.auth/logout"
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*", "/*.{png,jpg,jpeg,gif,svg,ico,css,js,woff,woff2}"]
    },
    "responseOverrides": {
        "401": {
            "statusCode": 302,
            "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer"
        }
    },
    "globalHeaders": {
        "Cache-Control": "no-store, must-revalidate",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
    }
}
